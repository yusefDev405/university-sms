PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
PGLITE_DATA_DIR=../data/pgdata
# Optional: set DATABASE_URL to connect to an external PostgreSQL 16+ instance instead of embedded PGlite
# DATABASE_URL=postgres://usms_app:password@localhost:5432/university_sms
COOKIE_SECURE=false
